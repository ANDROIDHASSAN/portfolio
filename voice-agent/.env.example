# Copy to .env.local and fill in there. Never put real values in this file: it is meant to be committed.
# Personal LiveKit Cloud project only (cloud.livekit.io -> Settings -> Keys).
LIVEKIT_URL=wss://your-personal-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# console.groq.com/keys: LLM, plus Whisper as the last STT fallback
GROQ_API_KEY=
# Optional. Each engine is skipped when its key is empty.
ELEVEN_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
# Optional overrides
# ELEVEN_VOICE_ID=
# SARVAM_SPEAKER=aditya
# NOISE_CANCELLATION=0
